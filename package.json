{
  "name": "website",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node -r @swc-node/register scripts/generate-search-index.ts && next dev -p 4000",
    "build": "node -r @swc-node/register scripts/generate-feeds.ts && node -r @swc-node/register scripts/generate-search-index.ts && next build && node -r @swc-node/register scripts/prune-css.ts && node -r @swc-node/register scripts/assert-deferred.ts",
    "export": "node -r @swc-node/register scripts/generate-search-index.ts && STATIC_EXPORT=1 next build && node -r @swc-node/register scripts/prune-css.ts && node -r @swc-node/register scripts/assert-deferred.ts --export",
    "analyze": "ANALYZE=true NODE_ENV=production next build && node -r @swc-node/register scripts/analyze-bundles.ts",
    "start": "next start",
    "prepare": "husky"
  },
  "dependencies": {
    "confetti-js": "^0.0.18",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "image-size": "^2.0.2",
    "lowlight": "^3.3.0",
    "mdast-util-definitions": "^6.0.0",
    "mdast-util-to-string": "^4.0.0",
    "next": "^15.5.22",
    "preact": "^10.29.8",
    "preact-render-to-string": "^6.7.0",
    "react": "npm:@preact/compat@^18.3.2",
    "react-dom": "npm:@preact/compat@^18.3.2",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-html": "^16.0.1",
    "remark-smartypants": "^3.0.3",
    "sass": "^1.102.0",
    "strip-markdown": "^6.0.0",
    "unist-util-remove": "^4.0.0",
    "unist-util-visit": "^5.1.0",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@next/bundle-analyzer": "^15.5.22",
    "@prefresh/webpack": "^4.0.6",
    "@rushstack/eslint-patch": "^1.16.1",
    "@svgr/webpack": "^8.1.0",
    "@swc-node/register": "^1.12.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/rss": "^0.0.32",
    "css-class-generator": "^2.0.0",
    "cssnano": "^8.0.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "globby": "^16.2.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "postcss": "^8.5.26",
    "postcss-flexbugs-fixes": "^5.0.2",
    "postcss-preset-env": "^11.3.2",
    "postcss-selector-parser": "^7.1.5",
    "prettier": "^3.9.6",
    "rss": "^1.2.2",
    "typescript": "^5.9.3",
    "webpack": "^5.109.2"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "^0.35.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "eslint --cache --fix",
    "*.{js,jsx,ts,tsx,css,md}": "prettier --write"
  }
}
